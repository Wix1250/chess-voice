{
  "name": "chess-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Play chess on Lichess with live voice chat",
  "type": "module",
  "main": "server.js",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "esbuild client/main.js --bundle --format=esm --minify --sourcemap --outfile=public/app.js",
    "start": "npm run build && node server.js",
    "dev": "npm run build && node --watch server.js"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
